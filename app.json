{
  "expo": {
    "owner": "gokula",
    "name": "Work Tracker",
    "slug": "work-tracker",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.png",
    "scheme": "work-tracker",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/app-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.worktracker.task",
      "appleTeamId": "V9G53UFKD3",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.worktracker.task"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.worktracker.task"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "./plugins/withSharedGroupPreferences",
      "./plugins/withWorkTrackerWidget",
      "./plugins/withLiveActivity",
      "./plugins/withDevelopmentTeam"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8359bdce-1948-481d-8df4-77707f4c46f1",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "WorkTrackerWidget",
                  "bundleIdentifier": "com.worktracker.task.WorkTrackerWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.worktracker.task"
                    ]
                  }
                },
                {
                  "targetName": "WorkTrackerLiveActivity",
                  "bundleIdentifier": "com.worktracker.task.WorkTrackerLiveActivity"
                }
              ]
            }
          }
        }
      }
    }
  }
}